# SPDX-License-Identifier: Apache-2.0
# Config fragment for Aether's QEMU/VM device profile (issue #185, Phase 0
# of docs/rlinux-migration.md). tools/build-rlinux-kernel.sh merges this
# onto the kernel's x86_64_defconfig with scripts/kconfig/merge_config.sh.
#
# Everything is =y (built in), not as modules: this phase delivers a bare
# bzImage for QEMU, and there is no module loading story yet. The device
# set is what Aether's QEMU profile needs to boot and use the VM:
# EFI boot, an initrd, a console, input (PS/2), display (stdvga + EFI
# simple framebuffer), block (virtio-blk), and networking (e1000/e1000e).
#
# tools/build-rlinux-kernel.sh fails the build if any symbol below is
# missing from, or not =y in, the final .config: Kconfig silently drops
# symbols whose dependencies are unmet, so this is checked, not assumed.
CONFIG_RUST=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
CONFIG_DRM=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_E1000=y
CONFIG_E1000E=y
